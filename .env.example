# Never commit real secrets.

TELEPAT_ENV=development

# Conversation LLM: undecided visible brain.
# auto = try providers in TELEPAT_CONVERSATION_FALLBACKS order.
TELEPAT_CONVERSATION_PROVIDER=auto
TELEPAT_CONVERSATION_FALLBACKS=groq,gemini,openai,claude,mock
# Optional compatibility override; applied only when provider is explicitly
# selected (not in auto fallback mode).
TELEPAT_CONVERSATION_MODEL=
TELEPAT_GEMINI_MODEL=gemini-3.8-flash
TELEPAT_GROQ_MODEL=openai/gpt-oss-120b
TELEPAT_OPENAI_MODEL=gpt-6-luna
TELEPAT_CLAUDE_MODEL=

GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Astrofractal interpretation: Gemini.
TELEPAT_ASTRO_PROVIDER=gemini
TELEPAT_ASTRO_MODEL=gemini-3.8-flash

# Voice
DEEPGRAM_API_KEY=
YANDEX_SPEECHKIT_API_KEY=
YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=
YANDEX_TTS_VOICE=ermil
YANDEX_TTS_EMOTION=neutral
YANDEX_TTS_SPEED=0.96

# Microsoft multilingual TTS
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=en-US-AndrewMultilingualNeural
AZURE_TTS_STYLE=empathetic

# Existing remote memory service
MEMORY_API_URL=
MEMORY_API_KEY=
# Defaults to Authorization: Bearer <MEMORY_API_KEY>.
# For X-API-Key, set header=X-API-Key and scheme empty.
MEMORY_API_AUTH_HEADER=Authorization
MEMORY_API_AUTH_SCHEME=Bearer


# Runtime protection
TELEPAT_RATE_LIMIT_WINDOW_SECONDS=60
TELEPAT_RATE_LIMIT_MAX_ENTRIES=5000
TELEPAT_CHAT_RPM=30
TELEPAT_ASTRO_RPM=6
TELEPAT_VOICE_CONNECT_RPM=12
TELEPAT_METRICS_SAMPLE_LIMIT=200
TELEPAT_SESSION_TTL_SECONDS=21600
TELEPAT_MAX_SESSIONS=1000
TELEPAT_MAX_HISTORY_TURNS=60


# Avatar runtime (set only after GPU benchmark selects an engine)
TELEPAT_AVATAR_ENGINE=
TELEPAT_AVATAR_GPU_ENABLED=0
