# Never commit real secrets.

TELEPAT_ENV=development

# ----------------------------
# Conversational AI
# ----------------------------
# auto = Groq -> Gemini -> local mock
# Later this can be changed to the chosen final conversational provider.
TELEPAT_CONVERSATION_PROVIDER=auto

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
# Put an active Gemini text model id here when configuring Modal.
GEMINI_MODEL=

# Astrofractal interpretation is a separate Gemini role.
TELEPAT_ASTRO_PROVIDER=gemini
TELEPAT_ASTRO_MODEL=

# Reserved for a future conversation provider if selected.
OPENAI_API_KEY=

# ----------------------------
# Voice input
# ----------------------------
DEEPGRAM_API_KEY=

# ----------------------------
# Russian TTS — Yandex SpeechKit / Ermil
# ----------------------------
# API-key auth is simplest: folder id is then not required by SpeechKit v1.
YANDEX_SPEECHKIT_API_KEY=
# Optional alternative auth:
YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=

YANDEX_TTS_VOICE=ermil
YANDEX_TTS_EMOTION=neutral
YANDEX_TTS_SPEED=0.96

# ----------------------------
# Existing remote memory service
# ----------------------------
MEMORY_API_URL=
MEMORY_API_KEY=
